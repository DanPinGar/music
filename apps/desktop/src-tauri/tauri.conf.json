{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Segno",
  "identifier": "io.github.danpingar.segno",
  "build": {
    "beforeDevCommand": "pnpm --filter @segno/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @segno/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Segno",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Study Synthesia-style piano videos",
    "longDescription": "Segno plays, navigates, transcribes and analyses Synthesia-style piano videos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
