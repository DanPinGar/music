              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The sprite, as a JPEG image"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video, or no thumbnails yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttacksDto": {
        "type": "object",
        "description": "The attacks (note onsets) found in a video's audio, served by `/attacks`.",
        "required": [
          "version",
          "times",
          "strengths"
        ],
        "properties": {
          "strengths": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "description": "How strong each attack is, from 0 to 1 (1 for the strong attacks of the video)."
          },
          "times": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "When each attack happens, in seconds, in order."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "BeatGridDto": {
        "type": "object",
        "description": "Beats tapped by the user. Before the first and after the last, the grid continues at the\ntempo of its ends.",
        "required": [
          "beats_ms",
          "beats_per_bar",
          "downbeat"
        ],
        "properties": {
          "beats_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Times of the beats, strictly increasing."
          },
          "beats_per_bar": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "downbeat": {
            "type": "integer",
            "format": "int32",
            "description": "Index of a beat that starts bar 1 (it may lie outside `beats_ms`)."
          }
        }
      },
      "CommentDto": {
        "type": "object",
        "description": "A comment on a moment or a stretch of a video.",
        "required": [
          "id",
          "start_ms",
          "body",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "Markdown."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "End of the stretch commented on; absent for a moment."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommentFieldsDto": {
        "type": "object",
        "description": "The text and anchor of a comment, to create one or replace an existing one's.",
        "required": [
          "start_ms",
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "Markdown, not empty."
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Result of the liveness probe.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the API is serving."
          }
        }
      },
      "ImportVideoRequest": {
        "type": "object",
        "description": "A video file on this computer to add to the library.",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path of the file."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title in the library; the file name when omitted."
          }
        }
      },
      "LoopRangeDto": {
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "end_ms": {
            "type": "integer",
            "format": "int64"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MarkerChangesDto": {
        "type": "object",
        "description": "Every editable field of a marker (its kind cannot change).",
        "required": [
          "start_ms"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "label": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MarkerDto": {
        "type": "object",
        "description": "A marker on a video's timeline.",
        "required": [
          "id",
          "kind",
          "start_ms",
          "label",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "`#rrggbb`; absent for the default colour."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "End of a section or loop; absent for points."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/MarkerKindDto"
          },
          "label": {
            "type": "string",
            "description": "May be empty: the UI then shows the marker's number."
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MarkerKindDto": {
        "type": "string",
        "description": "A point to start from, a named section or a saved loop.",
        "enum": [
          "point",
          "section",
          "loop"
        ]
      },
      "NewMarkerDto": {
        "type": "object",
        "description": "A new marker.",
        "required": [
          "kind",
          "start_ms"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/MarkerKindDto"
          },
          "label": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PeaksDto": {
        "type": "object",
        "description": "The audio waveform of a video, served by `/peaks`.",
        "required": [
          "version",
          "peaks_per_second",
          "peaks"
        ],
        "properties": {
          "peaks": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "A minimum and a maximum per slot, in turn, from -127 to 127."
          },
          "peaks_per_second": {
            "type": "integer",
            "format": "int32",
            "description": "Pairs per second of audio.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PracticeDto": {
        "type": "object",
        "description": "How loops are practised.",
        "required": [
          "pre_roll_beats",
          "count_in"
        ],
        "properties": {
          "count_in": {
            "type": "boolean",
            "description": "A bar of metronome clicks before playback starts."
          },
          "pre_roll_beats": {
            "type": "integer",
            "format": "int32",
            "description": "Beats played before the loop start on every repetition.",
            "minimum": 0
          },
          "trainer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SpeedTrainerDto"
              }
            ]
          }
        }
      },
      "PreparationDto": {
        "type": "object",
        "description": "Progress of preparing a video for navigation.",
        "required": [
          "stage",
          "progress"
        ],
        "properties": {
          "progress": {
            "type": "number",
            "format": "double",
            "description": "The whole preparation, from 0 to 1."
          },
          "stage": {
            "$ref": "#/components/schemas/PreparationStageDto"
          }
        }
      },
      "PreparationStageDto": {
        "type": "string",
        "description": "The step running, in order: waiting, the waveform peaks, the attacks, the seek proxy and\nthe thumbnails.",
        "enum": [
          "queued",
          "peaks",
          "attacks",
          "seek_proxy",
          "thumbnails"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explanation specific to this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type; `about:blank` when the status code says it all."
          }
        }
      },
      "SpeedTrainerDto": {
        "type": "object",
        "description": "Speeds the loop up on every repetition: `from`, then `step` more each time, up to `to`.",
        "required": [
          "from",
          "step",
          "to"
        ],
        "properties": {
          "from": {
            "type": "number",
            "format": "double"
          },
          "step": {
            "type": "number",
            "format": "double"
          },
          "to": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "StepUnitDto": {
        "type": "string",
        "description": "What the arrow keys step by.",
        "enum": [
          "seconds",
          "beat",
          "bar"
        ]
      },
      "SystemInfo": {
        "type": "object",
        "description": "Facts about the running core, shown in the UI's status bar.",
        "required": [
          "version",
          "library_id",
          "schema_version"
        ],
        "properties": {
          "ffmpeg_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Version of the ffmpeg in use; `None` when it was not found."
          },
          "library_id": {
            "type": "string",
            "description": "Identity of the library, stable for its whole life (unlike its folder)."
          },
          "library_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Folder holding the library database and media, when served locally."
          },
          "schema_version": {
            "type": "integer",
            "format": "int64",
            "description": "Latest database migration applied."
          },
          "version": {
            "type": "string",
            "description": "Version of the core."
          }
        }
      },
      "ThumbnailsDto": {
        "type": "object",
        "description": "Layout of the thumbnail sprite: tile `n` shows the video at `n * interval_ms`, at column\n`n % columns` and row `n / columns`.",
        "required": [
          "columns",
          "rows",
          "tile_width",
          "tile_height",
          "interval_ms",
          "count"
        ],
        "properties": {
          "columns": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "interval_ms": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tile_height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tile_width": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TimelineViewDto": {
        "type": "object",
        "required": [
          "start_ms",
          "span_ms"
        ],
        "properties": {
          "span_ms": {
            "type": "integer",
            "format": "int64"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "VideoDto": {
        "type": "object",
        "description": "A video in the library.",
        "required": [
          "id",
          "source",
          "title",
          "status",
          "seek_proxy",
          "has_peaks",
          "has_attacks",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "channel": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "fps": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "has_attacks": {
            "type": "boolean",
            "description": "Whether `/attacks` serves the attacks (note onsets) found in the audio."
          },
          "has_peaks": {
            "type": "boolean",
            "description": "Whether `/peaks` serves the audio waveform."
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "preparation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PreparationDto",
                "description": "Present while the video is being prepared for navigation."
              }
            ]
          },
          "preparation_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the preparation failed, if it did."
          },
          "seek_proxy": {
            "type": "boolean",
            "description": "Whether `/media` already serves the copy made for instant seeking."
          },
          "source": {
            "$ref": "#/components/schemas/VideoSourceDto"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Original address, for downloaded videos."
          },
          "status": {
            "$ref": "#/components/schemas/VideoStatusDto"
          },
          "thumbnails": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ThumbnailsDto",
                "description": "Thumbnail sprite served at `/thumbnails`, once made."
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "VideoSourceDto": {
        "type": "string",
        "description": "Where a video came from.",
        "enum": [
          "youtube",
          "file"
        ]
      },
      "VideoStateDto": {
        "type": "object",
        "description": "Where the user left a video, so it reopens the same way.",
        "required": [
          "position_ms",
          "speed",
          "step_unit",
          "practice"
        ],
        "properties": {
          "beat_grid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BeatGridDto"
              }
            ]
          },
          "loop": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LoopRangeDto"
              }
            ]
          },
          "position_ms": {
            "type": "integer",
            "format": "int64"
          },
          "practice": {
            "$ref": "#/components/schemas/PracticeDto"
          },
          "speed": {
            "type": "number",
            "format": "double",
            "description": "Playback rate, from 0.25 to 2 (1 is normal speed)."
          },
          "step_unit": {
            "$ref": "#/components/schemas/StepUnitDto"
          },
          "view": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TimelineViewDto",
                "description": "The stretch the detail timeline showed."
              }
            ]
          }
        }
      },
      "VideoStatusDto": {
        "type": "string",
        "description": "Lifecycle of a library entry.",
        "enum": [
          "importing",
          "ready",
          "failed"
        ]
      }
    },
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and version of the core"
    },
    {
      "name": "videos",
      "description": "Videos in the library"
    },
    {
      "name": "study",
      "description": "Where the user left each video, and its markers"
    }
  ]
}
