{
  "openapi": "3.1.0",
  "info": {
    "title": "Segno API",
    "description": "Core API of Segno: library, navigation data, markers, comments and analysis jobs.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe. Needs no token.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The API is serving",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Version and storage details of the running core.",
        "operationId": "get_system",
        "responses": {
          "200": {
            "description": "Facts about the core",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "Lists the videos in the library, newest first.",
        "operationId": "list_videos",
        "responses": {
          "200": {
            "description": "Videos in the library",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VideoDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/import": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Imports a video file from this computer into the library, ready to play, and queues its\npreparation for instant navigation.",
        "operationId": "import_video",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportVideoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The imported video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoDto"
                }
              }
            }
          },
          "400": {
            "description": "Not a file, or not a readable video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "ffmpeg is not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/{id}": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "Gets one video.",
        "operationId": "get_video",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/{id}/attacks": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "The attacks (note onsets) found in the audio, for stepping from note to note.",
        "operationId": "get_attacks",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The attacks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttacksDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video, or no attacks yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/{id}/media": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "The video for the player: the copy made for instant seeking once it exists, the original\nuntil then. Supports `Range` requests. Media elements cannot send headers: pass the token\nas the `token` query parameter.",
        "operationId": "get_media",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole media file"
          },
          "206": {
            "description": "The byte range asked for with a Range header"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video, or it has no media yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/{id}/peaks": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "The audio waveform: a minimum and a maximum per slot of audio.",
        "operationId": "get_peaks",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The waveform peaks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeaksDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video, or no waveform yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/videos/{id}/thumbnails": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "The thumbnail sprite (JPEG); its layout is in the video's `thumbnails`.",
        "operationId": "get_thumbnails",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The sprite, as a JPEG image"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such video, or no thumbnails yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttacksDto": {
        "type": "object",
        "description": "The attacks (note onsets) found in a video's audio, served by `/attacks`.",
        "required": [
          "version",
          "times",
          "strengths"
        ],
        "properties": {
          "strengths": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "description": "How strong each attack is, from 0 to 1 (1 for the strong attacks of the video)."
          },
          "times": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "When each attack happens, in seconds, in order."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Result of the liveness probe.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the API is serving."
          }
        }
      },
      "ImportVideoRequest": {
        "type": "object",
        "description": "A video file on this computer to add to the library.",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path of the file."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title in the library; the file name when omitted."
          }
        }
      },
      "PeaksDto": {
        "type": "object",
        "description": "The audio waveform of a video, served by `/peaks`.",
        "required": [
          "version",
          "peaks_per_second",
          "peaks"
        ],
        "properties": {
          "peaks": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "A minimum and a maximum per slot, in turn, from -127 to 127."
          },
          "peaks_per_second": {
            "type": "integer",
            "format": "int32",
            "description": "Pairs per second of audio.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PreparationDto": {
        "type": "object",
        "description": "Progress of preparing a video for navigation.",
        "required": [
          "stage",
          "progress"
        ],
        "properties": {
          "progress": {
            "type": "number",
            "format": "double",
            "description": "The whole preparation, from 0 to 1."
          },
          "stage": {
            "$ref": "#/components/schemas/PreparationStageDto"
          }
        }
      },
      "PreparationStageDto": {
        "type": "string",
        "description": "The step running, in order: waiting, the waveform peaks, the attacks, the seek proxy and\nthe thumbnails.",
        "enum": [
          "queued",
          "peaks",
          "attacks",
          "seek_proxy",
          "thumbnails"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explanation specific to this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type; `about:blank` when the status code says it all."
          }
        }
      },
      "SystemInfo": {
        "type": "object",
        "description": "Facts about the running core, shown in the UI's status bar.",
        "required": [
          "version",
          "library_id",
          "schema_version"
        ],
        "properties": {
          "ffmpeg_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Version of the ffmpeg in use; `None` when it was not found."
          },
          "library_id": {
            "type": "string",
            "description": "Identity of the library, stable for its whole life (unlike its folder)."
          },
          "library_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Folder holding the library database and media, when served locally."
          },
          "schema_version": {
            "type": "integer",
            "format": "int64",
            "description": "Latest database migration applied."
          },
          "version": {
            "type": "string",
            "description": "Version of the core."
          }
        }
      },
      "ThumbnailsDto": {
        "type": "object",
        "description": "Layout of the thumbnail sprite: tile `n` shows the video at `n * interval_ms`, at column\n`n % columns` and row `n / columns`.",
        "required": [
          "columns",
          "rows",
          "tile_width",
          "tile_height",
          "interval_ms",
          "count"
        ],
        "properties": {
          "columns": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "interval_ms": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tile_height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tile_width": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "VideoDto": {
        "type": "object",
        "description": "A video in the library.",
        "required": [
          "id",
          "source",
          "title",
          "status",
          "seek_proxy",
          "has_peaks",
          "has_attacks",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "channel": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "fps": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "has_attacks": {
            "type": "boolean",
            "description": "Whether `/attacks` serves the attacks (note onsets) found in the audio."
          },
          "has_peaks": {
            "type": "boolean",
            "description": "Whether `/peaks` serves the audio waveform."
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "preparation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PreparationDto",
                "description": "Present while the video is being prepared for navigation."
              }
            ]
          },
          "preparation_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the preparation failed, if it did."
          },
          "seek_proxy": {
            "type": "boolean",
            "description": "Whether `/media` already serves the copy made for instant seeking."
          },
          "source": {
            "$ref": "#/components/schemas/VideoSourceDto"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Original address, for downloaded videos."
          },
          "status": {
            "$ref": "#/components/schemas/VideoStatusDto"
          },
          "thumbnails": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ThumbnailsDto",
                "description": "Thumbnail sprite served at `/thumbnails`, once made."
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "VideoSourceDto": {
        "type": "string",
        "description": "Where a video came from.",
        "enum": [
          "youtube",
          "file"
        ]
      },
      "VideoStatusDto": {
        "type": "string",
        "description": "Lifecycle of a library entry.",
        "enum": [
          "importing",
          "ready",
          "failed"
        ]
      }
    },
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and version of the core"
    },
    {
      "name": "videos",
      "description": "Videos in the library"
    }
  ]
}
