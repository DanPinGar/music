    "/videos/{id}/media": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "The video for the player: the copy made for instant seeking once it exists, the original\nuntil then. Supports `Range` requests. Media elements cannot send headers: pass the token\nas the `token` query parameter.",
        "operationId": "get_media",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Video id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole media file"
          },
          "206": {
            "description": "The byte range asked for with a Range header"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
